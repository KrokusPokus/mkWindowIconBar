# Maintainer: KrokusPokus
#
# Baut den aktuellen Stand des Standard-Branches von GitHub.
# Bauen und installieren: makepkg -si   (danach plasmashell neu starten, siehe .install)

pkgname=mkwindowiconbar-git
_pkgname=mkWindowIconBar
pkgver=r0.0000000
pkgrel=1
pkgdesc='Plasma 6 applet: window bar displaying only the windows own icons'
arch=('x86_64')
url='https://github.com/KrokusPokus/mkWindowIconBar'
license=('GPL-2.0-or-later')
depends=(
  'glibc'
  'kservice'
  'ki18n'
  'libplasma'
  'libstdc++'
  'qt6-base'
  'qt6-declarative'
  'wayland'
)
makedepends=(
  'cmake'
  'extra-cmake-modules'
  'git'
  'plasma-wayland-protocols'
)
provides=('mkwindowiconbar')
conflicts=('mkwindowiconbar')
install=mkwindowiconbar.install
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cmake -B build -S "$_pkgname" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
